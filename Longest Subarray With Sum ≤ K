arr = [2, 1, 5, 2, 3, 2]
k = 7
left = 0
window_sum = 0
max_length = 0

for right in range(len(arr)):
    window_sum += arr[right]

    while window_sum > k:
        window_sum -= arr[left]
        left += 1

    current_length = right - left + 1
    max_length = max(max_length, current_length)

print(max_length)
